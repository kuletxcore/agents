{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agents",
  "compatibility_date": "2026-11-01",
  "main": "./worker/index.ts",
  "build": {
    "command": "npm run build"
  },
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kuletxai",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG"
    }
  ],
  "triggers": {
    "crons": [
      "0 22 * * *"
    ]
  },
  "vars": {
    "WORKSPACE_MODE": "demo"
  },
  "env": {
    "private": {
      "name": "agents-private",
      "vars": {
        "WORKSPACE_MODE": "private"
      },
      "assets": {
        "directory": "./dist/client",
        "not_found_handling": "single-page-application",
        "binding": "ASSETS",
        "run_worker_first": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kuletxai-private",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CONFIG"
        }
      ],
      "triggers": {
        "crons": [
          "0 22 * * *"
        ]
      }
    }
  }
}
