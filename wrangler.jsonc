{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agents",
  "compatibility_date": "2026-11-01",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kuletxai",
      "database_id": "a8940822-c780-43c5-b2a3-ae5524339dc5",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG",
      "id": "8b65f0bf16c64ef68486a1483561687d"
    }
  ],
  "triggers": {
    "crons": ["0 22 * * *"]
  },
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "kuletxai",
        "database_id": "a8940822-c780-43c5-b2a3-ae5524339dc5"
      }
    ],
    "kv_namespaces": [
      {
        "binding": "CONFIG",
        "id": "8b65f0bf16c64ef68486a1483561687d"
      }
    ]
  }
}
