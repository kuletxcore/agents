# Optional OpenAI-compatible chat. Leave unset for demo mode.
# Copy to .dev.vars for `npm run dev` (wrangler reads .dev.vars; it is gitignored).
# Live calls also require OPERATOR_TOKEN, sent by the browser as x-kuletx-token.
# Without that match, chat stays on the demo adapter even if the key is set.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
OPERATOR_TOKEN=
